{
  "name": "@sovgut/datagrid",
  "version": "5.0.2",
  "description": "Headless, unstyled state management for React data grids: pagination, sorting, per-column filters, selection and column visibility, with the markup left entirely to you.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sovgut/datagrid.git"
  },
  "homepage": "https://github.com/Sovgut/datagrid#readme",
  "bugs": {
    "url": "https://github.com/Sovgut/datagrid/issues"
  },
  "author": {
    "name": "Serhii Sovhut",
    "url": "https://github.com/Sovgut"
  },
  "keywords": [
    "react",
    "datagrid",
    "data-grid",
    "table",
    "headless",
    "headless-ui",
    "unstyled",
    "typescript",
    "zustand",
    "pagination",
    "sorting",
    "filtering",
    "row-selection"
  ],
  "license": "MIT",
  "files": ["dist"],
  "sideEffects": false,
  "main": "./dist/datagrid.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/datagrid.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "deploy:npm": "npm publish --access public",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check --write --error-on-warnings .",
    "ci": "biome ci --error-on-warnings .",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
